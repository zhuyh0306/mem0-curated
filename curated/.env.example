# Copy to .env before `docker compose up`. Generate the secrets with `openssl rand -base64 32`.
# Worker keys are read-only by construction; keep them out of CURATOR_API_KEYS.
WORKER_API_KEYS=replace_me_worker_key
CURATOR_API_KEYS=replace_me_curator_key

# Shared secret between gateway and mem0-curated. Never hand this to a Worker.
INTERNAL_TOKEN=replace_me_internal_token

QDRANT_COLLECTION=experiences

# Default scope shown by the dashboard at http://127.0.0.1:8788. Agents set their own scope
# through CURATED_PROJECT_ID in the MCP connector env.
CURATED_PROJECT_ID=default

# EMBEDDER_DIMS must match EMBEDDER_MODEL. bge-small-en-v1.5 -> 384.
EMBEDDER_PROVIDER=fastembed
EMBEDDER_MODEL=BAAI/bge-small-en-v1.5
EMBEDDER_DIMS=384

# Uncomment if huggingface.co is unreachable from this host; the first start downloads the
# embedder model and hangs on retries otherwise. It is passed into the container by env_file.
# HF_ENDPOINT=https://hf-mirror.com
